VITE_POSTHOG_HOST=https://us.i.posthog.com

# Backend que usa la red social EN DESARROLLO.
# El proxy de vite.config.ts reenvia esta ruta al servidor del colegio desde
# Node, asi que el navegador nunca hace una peticion cross-origin (sin CORS).
# En produccion NO se usa: ver .env.production.
VITE_SOCIAL_API=/est/php/api.php

# Base del API del colegio. Si se deja vacio, se usa el dominio de produccion.
# Para trabajar solo contra el backend local (backend\) descomenta la linea:
#   VITE_API_BASE_URL=            (rutas relativas -> las resuelve el proxy de Vite)
# Con VITE_API_BASE_URL vacio hay que tener `npm run dev:php` corriendo, porque
# TODO el API (notas, convivencia, inasistencias) pasa a ir contra ese backend.
# GetExcusas.php no necesita esta variable: el proxy de vite.config.ts ya
# reenvia /est/php/GetExcusas.php al backend local sin tocar el resto del API.
# VITE_API_BASE_URL=
