# Variables del build de produccion (npm run build).
#
# VITE_SOCIAL_API se deja VACIO a proposito: en produccion el frontend calcula
# la ruta /est/php/api.php solo, a partir de la URL donde este montada la app.
# Si se pusiera una URL fija aqui, el despliegue quedaria atado a un dominio.
VITE_SOCIAL_API=
